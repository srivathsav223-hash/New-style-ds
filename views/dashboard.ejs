<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>👑 RINTU DASHBOARD</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background: #0a0a0a; color: #00ffc8; font-family: 'Rajdhani', sans-serif; min-height: 100vh; }
        .container { max-width: 1400px; margin: 0 auto; padding: 20px; }
        .header { text-align: center; padding: 30px 0; }
        .header h1 { font-family: 'Orbitron', monospace; font-size: 3.5rem; background: linear-gradient(135deg, #00ffc8, #ff0040, #ff8800); -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: shift 3s ease-in-out infinite; background-size: 300% 300%; }
        @keyframes shift { 0%,100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
        .header .sub { color: #666; letter-spacing: 6px; font-size: 1rem; }
        .glass { background: rgba(10,10,10,0.8); backdrop-filter: blur(12px); border: 1px solid rgba(0,255,200,0.1); border-radius: 16px; padding: 20px; margin: 12px 0; }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin: 15px 0; }
        .stat { background: rgba(0,255,200,0.03); border-radius: 12px; padding: 15px 20px; border: 1px solid rgba(0,255,200,0.06); }
        .stat .label { color: #666; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 2px; }
        .stat .value { font-size: 2rem; font-weight: 700; font-family: 'Orbitron', monospace; background: linear-gradient(135deg, #00ffc8, #00ff88); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .stat .value.gold { background: linear-gradient(135deg, #ff8800, #ffcc00); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .login-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.97); display: flex; justify-content: center; align-items: center; z-index: 999; }
        .login-box { background: rgba(10,10,10,0.9); border: 2px solid rgba(0,255,200,0.2); border-radius: 20px; padding: 50px 40px; min-width: 360px; text-align: center; }
        .login-box h2 { font-family: 'Orbitron', monospace; font-size: 2.5rem; background: linear-gradient(135deg, #ff0040, #ff8800); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .login-box input { background: rgba(0,0,0,0.6); color: #00ffc8; border: 1px solid rgba(0,255,200,0.15); padding: 14px; width: 100%; border-radius: 10px; font-size: 1rem; margin: 10px 0; font-family: 'Rajdhani', sans-serif; outline: none; }
        .login-box input:focus { border-color: rgba(0,255,200,0.5); }
        .login-box button { background: linear-gradient(135deg, #ff0040, #ff4400); color: #fff; border: none; padding: 14px; border-radius: 10px; font-weight: 700; font-size: 1.1rem; cursor: pointer; width: 100%; font-family: 'Rajdhani', sans-serif; transition: 0.3s; }
        .login-box button:hover { transform: scale(1.02); }
        .btn { background: rgba(0,255,200,0.08); color: #00ffc8; border: 1px solid rgba(0,255,200,0.15); padding: 8px 16px; border-radius: 8px; cursor: pointer; font-family: 'Rajdhani', sans-serif; font-weight: 600; font-size: 0.8rem; transition: 0.3s; text-transform: uppercase; }
        .btn:hover { background: rgba(0,255,200,0.15); }
        .btn.danger { border-color: rgba(255,0,64,0.3); color: #ff0040; }
        .btn.danger:hover { background: rgba(255,0,64,0.15); }
        .btn.primary { border-color: rgba(255,136,0,0.3); color: #ff8800; }
        .btn.primary:hover { background: rgba(255,136,0,0.15); }
        .btn.gold { border-color: rgba(255,204,0,0.3); color: #ffcc00; }
        .btn.gold:hover { background: rgba(255,204,0,0.15); }
        .btn.small { padding: 4px 10px; font-size: 0.7rem; }
        .input-group { display: flex; gap: 10px; flex-wrap: wrap; margin: 8px 0; }
        .input-group input, .input-group textarea { background: rgba(0,0,0,0.5); color: #00ffc8; border: 1px solid rgba(0,255,200,0.1); padding: 10px 14px; border-radius: 8px; font-family: 'Rajdhani', sans-serif; font-size: 0.9rem; outline: none; flex: 1; min-width: 140px; }
        .input-group input:focus, .input-group textarea:focus { border-color: rgba(0,255,200,0.3); }
        .token-list { max-height: 300px; overflow-y: auto; margin-top: 10px; }
        .token-item { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; border-bottom: 1px solid rgba(0,255,200,0.05); font-size: 0.8rem; }
        .token-item .t { color: #666; font-family: monospace; max-width: 200px; overflow: hidden; text-overflow: ellipsis; }
        .token-item .status { padding: 2px 12px; border-radius: 12px; font-size: 0.6rem; font-weight: 700; text-transform: uppercase; }
        .token-item .status.on { background: rgba(0,255,200,0.15); color: #00ffc8; }
        .token-item .status.off { background: rgba(255,0,64,0.15); color: #ff0040; }
        .key-item { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 8px; padding: 6px 8px; border-bottom: 1px solid rgba(255,204,0,0.05); font-size: 0.7rem; }
        .key-item .k { color: #ffcc00; font-family: monospace; }
        .flex { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
        .hidden { display: none !important; }
        ::-webkit-scrollbar { width: 4px; background: transparent; }
        ::-webkit-scrollbar-thumb { background: #00ffc8; border-radius: 4px; }
        @media (max-width: 768px) { .header h1 { font-size: 2rem; } .login-box { min-width: 300px; padding: 30px 20px; } }
    </style>
</head>
<body>

<div id="loginOverlay" class="login-overlay">
    <div class="login-box">
        <h2>👑 RINTU</h2>
        <div style="color:#666; letter-spacing:4px; margin:5px 0 20px;">DASHBOARD</div>
        <input type="password" id="adminPass" placeholder="Admin Password" onkeydown="if(event.key==='Enter') login()">
        <button onclick="login()">🔓 UNLOCK</button>
    </div>
</div>

<div id="dashboard" class="container hidden">
    <div class="header">
        <h1>👑 RINTU</h1>
        <div class="sub">DASHBOARD • v8.0</div>
    </div>

    <div class="glass" style="padding:12px 20px;">
        <div class="flex" style="justify-content:space-between;">
            <div class="flex">
                <span>📦 <span id="tokenCount">0</span> tokens</span>
                <span>🔑 <span id="keyCount">0</span> keys</span>
                <span>✅ <span id="enabledCount">0</span> enabled</span>
            </div>
            <button class="btn danger small" onclick="logout()">🔒 LOGOUT</button>
        </div>
    </div>

    <div class="grid">
        <div class="stat"><div class="label">📦 Total Tokens</div><div class="value" id="statTokens">0</div></div>
        <div class="stat"><div class="label">✅ Enabled</div><div class="value gold" id="statEnabled">0</div></div>
        <div class="stat"><div class="label">🔑 Keys</div><div class="value gold" id="statKeys">0</div></div>
    </div>

    <div class="glass">
        <div class="flex" style="justify-content:space-between;">
            <h2 style="color:#ff0040; font-size:1.2rem;">📁 TOKENS</h2>
            <button class="btn small" onclick="loadTokens()">🔄 REFRESH</button>
        </div>
        <div class="input-group">
            <input type="text" id="tokenInput" placeholder="Discord User Token" style="flex:3;">
            <input type="text" id="ownerInput" placeholder="Owner" style="flex:1;">
            <button class="btn primary" onclick="addToken()">➕ ADD</button>
        </div>
        <div class="token-list" id="tokenList"></div>
    </div>

    <div class="glass" style="border-color:rgba(255,204,0,0.2);">
        <div class="flex" style="justify-content:space-between;">
            <h2 style="color:#ffcc00; font-size:1.2rem;">🔑 KEYAUTH</h2>
            <div class="flex">
                <button class="btn gold small" onclick="generateKey()">✨ GENERATE</button>
                <button class="btn gold small" onclick="listKeys()">📋 LIST</button>
            </div>
        </div>
        <div class="input-group">
            <input type="text" id="keyOwner" placeholder="Owner Name" style="flex:1;">
            <input type="number" id="keyDays" value="30" placeholder="Days" style="width:80px;">
            <button class="btn gold" onclick="generateKey()">✨ GENERATE KEY</button>
        </div>
        <div id="keyDisplay" style="display:none; background:rgba(0,0,0,0.4); padding:12px; border-radius:8px; margin:8px 0;">
            <span style="color:#888;">🔑 Key:</span>
            <span id="generatedKey" style="color:#ffcc00; font-family:monospace; font-weight:bold;"></span>
            <span style="color:#888; margin-left:15px;">Owner:</span>
            <span id="keyOwnerDisplay" style="color:#00ffc8;"></span>
            <button class="btn small" onclick="copyKey()" style="margin-left:10px;">📋 COPY</button>
        </div>
        <div id="keyList" style="display:none; max-height:150px; overflow-y:auto; margin-top:10px;">
            <div id="keyListItems"></div>
        </div>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
    let socket = io();

    function login() {
        const pass = document.getElementById('adminPass').value;
        fetch('/api/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ password: pass }) })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                document.getElementById('loginOverlay').classList.add('hidden');
                document.getElementById('dashboard').classList.remove('hidden');
                loadTokens();
                loadStats();
                setInterval(loadStats, 3000);
            } else { alert('❌ Wrong password!'); }
        });
    }

    function logout() {
        fetch('/api/logout', { method: 'POST' })
        .then(() => {
            document.getElementById('loginOverlay').classList.remove('hidden');
            document.getElementById('dashboard').classList.add('hidden');
        });
    }

    function loadTokens() {
        fetch('/api/tokens').then(r => r.json()).then(data => {
            const list = document.getElementById('tokenList');
            if (!data || data.length === 0) {
                list.innerHTML = '<div style="color:#444; text-align:center; padding:20px;">No tokens added.</div>';
                return;
            }
            list.innerHTML = data.map(t => `
                <div class="token-item">
                    <span class="t">${t.token ? t.token.substring(0, 20) + '...' : 'Invalid'}</span>
                    <span style="color:#888;">${t.owner || 'default'}</span>
                    <span class="status ${t.enabled ? 'on' : 'off'}">${t.enabled ? 'ON' : 'OFF'}</span>
                    <div>
                        <button class="btn small" onclick="toggleToken(${t.id})">↕</button>
                        <button class="btn danger small" onclick="deleteToken(${t.id})">✕</button>
                    </div>
                </div>
            `).join('');
            document.getElementById('tokenCount').textContent = data.length;
            document.getElementById('statTokens').textContent = data.length;
            document.getElementById('statEnabled').textContent = data.filter(t => t.enabled).length;
            document.getElementById('enabledCount').textContent = data.filter(t => t.enabled).length;
        });
    }

    function addToken() {
        const token = document.getElementById('tokenInput').value.trim();
        const owner = document.getElementById('ownerInput').value.trim() || 'default';
        if (!token) return alert('❌ Enter a token!');
        if (token.length < 10) return alert('❌ Token too short!');
        fetch('/api/tokens/add', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ token, owner }) })
        .then(r => r.json()).then(data => {
            if (data.success) {
                document.getElementById('tokenInput').value = '';
                loadTokens();
            } else { alert('❌ Failed to add token'); }
        });
    }

    function deleteToken(id) {
        if (!confirm('Delete this token?')) return;
        fetch('/api/tokens/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) })
        .then(() => loadTokens());
    }

    function toggleToken(id) {
        fetch('/api/tokens/toggle', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) })
        .then(() => loadTokens());
    }

    function generateKey() {
        const owner = document.getElementById('keyOwner').value.trim() || 'default';
        const days = parseInt(document.getElementById('keyDays').value) || 30;
        fetch('/api/keys/create', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ owner, days }) })
        .then(r => r.json()).then(data => {
            if (data.success) {
                document.getElementById('generatedKey').textContent = data.key;
                document.getElementById('keyOwnerDisplay').textContent = data.owner;
                document.getElementById('keyDisplay').style.display = 'block';
                document.getElementById('keyList').style.display = 'none';
                loadStats();
            }
        });
    }

    function copyKey() {
        const key = document.getElementById('generatedKey').textContent;
        if (navigator.clipboard) { navigator.clipboard.writeText(key); }
    }

    function listKeys() {
        fetch('/api/keys/list').then(r => r.json()).then(data => {
            const list = document.getElementById('keyListItems');
            const container = document.getElementById('keyList');
            if (!data.keys || data.keys.length === 0) {
                list.innerHTML = '<div style="color:#444; text-align:center; padding:20px;">No keys generated.</div>';
            } else {
                list.innerHTML = data.keys.map(k => `<div class="key-item"><span class="k">${k.key}</span><span>${k.owner}</span><span style="color:#888; font-size:0.6rem;">${k.expires}</span></div>`).join('');
            }
            container.style.display = 'block';
            document.getElementById('keyDisplay').style.display = 'none';
        });
    }

    function loadStats() {
        fetch('/api/stats').then(r => r.json()).then(s => {
            document.getElementById('statTokens').textContent = s.tokens || 0;
            document.getElementById('statEnabled').textContent = s.enabled || 0;
            document.getElementById('statKeys').textContent = s.keys || 0;
            document.getElementById('keyCount').textContent = s.keys || 0;
        });
    }

    socket.on('stats', (data) => {
        if (data.tokens !== undefined) { document.getElementById('statTokens').textContent = data.tokens; document.getElementById('tokenCount').textContent = data.tokens; }
        if (data.enabled !== undefined) { document.getElementById('statEnabled').textContent = data.enabled; document.getElementById('enabledCount').textContent = data.enabled; }
        if (data.keys !== undefined) { document.getElementById('statKeys').textContent = data.keys; document.getElementById('keyCount').textContent = data.keys; }
    });

    document.addEventListener('keydown', (e) => { if (e.key === 'Enter' && document.activeElement.id === 'adminPass') login(); });
    console.log('👑 RINTU DASHBOARD v8.0 LOADED');
</script>
</body>
</html>
